{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./opencode-memory/src",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["opencode-memory/src/**/*.ts", "opencode-memory/src/**/*.tsx"],
  "exclude": [
    "opencode-memory/src/**/*.test.ts",
    "opencode-memory/src/**/*.test.tsx",
    "tests",
    "dist",
    "node_modules"
  ]
}
