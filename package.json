{
  "name": "@nguyenthdat/opencode-memory",
  "version": "0.6.0",
  "description": "Local-first persistent memory for OpenCode with a shared Rust daemon, zvec, and llama.cpp",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.0",
    "opencode": ">=1.18.4"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "opencode-memory": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js",
      "default": "./dist/tui.js"
    }
  },
  "files": [
    "dist",
    "rules/native-memory.md",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "notices"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "generate:protocol": "protoc --plugin=protoc-gen-es=./node_modules/.bin/protoc-gen-es --es_out=opencode-memory/src/generated --es_opt=target=ts,import_extension=js -I schema schema/opencode/memory/v1/memory.proto schema/opencode/memory/model/v1/model.proto schema/opencode/memory/graph/v1/graph.proto schema/opencode/memory/daemon/v1/daemon.proto",
    "generate:protocol:check": "bun scripts/check-generated-protocol.ts",
    "lint:proto": "buf lint",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:ts": "tsc -p tsconfig.build.json",
    "build": "bun run clean && bun run typecheck && bun run build:ts",
    "build:native": "cargo build --locked && bun scripts/stage-native.ts --profile debug --runtime --destination target/debug",
    "build:native:release": "cargo build --release --locked && bun scripts/stage-native.ts --profile release --runtime --destination target/release",
    "test:ts": "bun test --conditions=browser opencode-memory/tests tests/ts tests/benchmark",
    "benchmark:retrieval": "bun scripts/benchmark-retrieval.ts",
    "test:rust": "cargo test --locked --lib",
    "test:protocol": "bun scripts/test-protocol-e2e.ts",
    "test": "bun run test:ts && bun run test:rust",
    "lint": "bun run typecheck && cargo clippy --all-targets --locked -- -D warnings",
    "format": "prettier --write . && cargo fmt",
    "format:check": "prettier --check . && cargo fmt --check",
    "versions:check": "bun scripts/check-versions.ts",
    "pack:check": "bun scripts/verify-package.ts",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.13.0",
    "@opencode-ai/sdk": "1.18.4",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.4 <2",
    "@opentui/solid": ">=0.4.5",
    "solid-js": "1.9.12"
  },
  "peerDependenciesMeta": {
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@nguyenthdat/opencode-memory-darwin-arm64": "0.6.0",
    "@nguyenthdat/opencode-memory-linux-arm64-gnu": "0.6.0",
    "@nguyenthdat/opencode-memory-linux-x64-gnu": "0.6.0"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "brace-expansion": "5.0.8"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.4",
    "@opentui/solid": "0.4.5",
    "@bufbuild/protoc-gen-es": "2.13.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.2",
    "prettier": "^3.9.0",
    "solid-js": "1.9.12",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyenthdat/opencode-native-memory.git"
  },
  "homepage": "https://github.com/nguyenthdat/opencode-native-memory#readme",
  "bugs": {
    "url": "https://github.com/nguyenthdat/opencode-native-memory/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "memory",
    "ai-memory",
    "persistent-memory",
    "knowledge-management",
    "developer-tools",
    "semantic-search",
    "vector-search",
    "embeddings",
    "rag",
    "document-ingestion",
    "document-indexing",
    "auto-indexing",
    "local-first",
    "privacy",
    "rust",
    "typescript",
    "llama.cpp",
    "huggingface",
    "protobuf",
    "zvec"
  ],
  "author": "Dat Nguyen",
  "license": "MIT"
}
